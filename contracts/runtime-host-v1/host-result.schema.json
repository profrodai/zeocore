{
  "$defs": {
    "AttemptBinding": {
      "additionalProperties": false,
      "description": "Stable identity and exact inputs; a new attempt preserves operation ID.",
      "properties": {
        "attempt_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Attempt Id",
          "type": "string"
        },
        "capability_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Capability Id",
          "type": "string"
        },
        "fencing_generation": {
          "minimum": 1,
          "title": "Fencing Generation",
          "type": "integer"
        },
        "manifest_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Manifest Digest",
          "type": "string"
        },
        "operation_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Operation Id",
          "type": "string"
        },
        "organization_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Organization Id",
          "type": "string"
        },
        "packet_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Packet Id",
          "type": "string"
        },
        "project_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Project Id",
          "type": "string"
        },
        "request_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Request Digest",
          "type": "string"
        },
        "runtime_binding_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Runtime Binding Id",
          "type": "string"
        },
        "seat_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Seat Id",
          "type": "string"
        }
      },
      "required": [
        "organization_id",
        "project_id",
        "seat_id",
        "runtime_binding_id",
        "packet_id",
        "operation_id",
        "attempt_id",
        "fencing_generation",
        "capability_id",
        "request_digest",
        "manifest_digest"
      ],
      "title": "AttemptBinding",
      "type": "object"
    },
    "JsonValue": {}
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_refs": {
      "default": [],
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/AttemptBinding"
        },
        {
          "type": "null"
        }
      ]
    },
    "data": {
      "$ref": "#/$defs/JsonValue",
      "default": null
    },
    "effect_disposition": {
      "enum": [
        "none",
        "confirmed",
        "unknown"
      ],
      "title": "Effect Disposition",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "protocol_version": {
      "const": 1,
      "title": "Protocol Version",
      "type": "integer"
    },
    "state": {
      "enum": [
        "succeeded",
        "invalid_request",
        "failed",
        "refused",
        "unavailable",
        "cancelled",
        "timed_out",
        "queued",
        "running",
        "waiting_approval",
        "needs_reconciliation",
        "protocol_error"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "protocol_version",
    "binding",
    "state",
    "effect_disposition"
  ],
  "title": "HostResult",
  "type": "object"
}
