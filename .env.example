# ZeoCore secrets -- copy this file to `.env` and fill in real values.
#
# `.env` is the documented home for secrets in ZeoCore: it is already
# gitignored (see .gitignore's "Secrets" section), unlike YAML config files,
# which get committed by default. Settings go in YAML; secrets go here.
#
# ZeoCore does not load `.env` on import (no implicit I/O -- see
# zeo_core/config/__init__.py's Kernel philosophy) -- call
# `zeo_core.config.load_dotenv_file()` once, early, in your own entrypoint
# and it is loaded. That's the whole call; it searches upward from your
# CWD for a file named `.env` exactly like this one, the same way
# `uv run --env-file .env ...` or your deployment platform's own env
# injection would, and never overwrites a variable you already set
# explicitly. Once the values below are in the process environment,
# ZeoCore's integrations read them directly; nothing else to configure.
#
# Never commit a real value. This file ships with placeholders only.

# Notion integration bearer token (see GET-STARTED.md "Integration Authentication").
NOTION_TOKEN=your-notion-integration-token

# GitHub integration token.
GITHUB_TOKEN=your-github-token

# OpenAI LLM client API key (zeo_core.integrations.llms).
OPENAI_API_KEY=your-openai-api-key

# Anthropic LLM client API key (zeo_core.integrations.llms).
ANTHROPIC_API_KEY=your-anthropic-api-key

# Bluesky identifier (handle or email) and APP PASSWORD -- not your main
# account password. Create one at bsky.app: Settings > App Passwords.
# No developer app, no OAuth, no approval needed (RULING-409 s6c).
BLUESKY_IDENTIFIER=your-handle.bsky.social
BLUESKY_APP_PASSWORD=your-bluesky-app-password
# Optional: only needed for a non-default PDS host.
BLUESKY_SERVICE_URL=https://bsky.social
